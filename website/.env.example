# ── سایت ──
# آدرس کامل سایت (برای callback پرداخت و ساخت لینک‌ها)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# فقط سمت سرور — هرگز در کلاینت استفاده نشود
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── زرین‌پال ──
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# برای تست روی درگاه sandbox مقدار true بگذارید
ZARINPAL_SANDBOX=true

# ── Google Calendar + Meet (اختیاری) ──
# روش ۱: OAuth Refresh Token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# روش ۲: Service Account (با Domain-Wide Delegation)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_IMPERSONATE_EMAIL=
# مشترک
GOOGLE_CALENDAR_ID=primary
